{
  "name": "omarchy-site",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vp dev",
    "generate-routes": "tsr generate",
    "build": "vp run port && vp build && node scripts/assemble-static.mjs",
    "preview": "vp preview",
    "lint": "vp lint",
    "format": "vp check --fix",
    "check": "vp check",
    "test": "vp test",
    "refresh-data": "node scripts/refresh-data.mjs",
    "deploy": "vp run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "port": "python3 scripts/port_content.py",
    "assemble": "node scripts/assemble-static.mjs",
    "parity": "python3 scripts/parity.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/start-static-server-functions": "^1.167.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.37.0",
    "motion": "^13.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.19.0",
    "shaders": "^3.1.463",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "wrangler": "^4.127.1",
    "vite-plus": "0.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vitest": "4.1.11"
  }
}
